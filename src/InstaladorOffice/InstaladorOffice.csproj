<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compila un solo InstaladorOffice.exe para .NET Framework 4.8 (incluido en Windows 10/11).
    Se puede compilar desde Linux o Windows con el SDK de .NET:
      dotnet build -c Release
    o con los scripts build.sh / build.cmd de la raíz, que dejan el exe en dist\.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>InstaladorOffice</RootNamespace>
    <AssemblyName>InstaladorOffice</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- 64 bits en Windows x64: necesario para leer el registro de Office y ejecutar ospp/slmgr sin redirección -->
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Product>Instalador de Office (ODT)</Product>
    <AssemblyTitle>Instalador y activador de Office</AssemblyTitle>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Permite compilar para .NET Framework sin tenerlo instalado (Linux) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Management" />
  </ItemGroup>

</Project>
